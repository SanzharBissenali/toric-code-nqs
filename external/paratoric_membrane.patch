+void Lattice::construct_fredenhagen_marcu_membrane(char basis) {
+    // Magnetic ('t Hooft) FM membranes, 3D cubic lattice, basis 'x' only (sigma^x
+    // products are diagonal in the x eigenbasis). Mirrors the NQS operators
+    // (tc3d/fm.py paratoric_membrane_kwargs -> magnetic_cube_edges) EDGE-FOR-EDGE.
+    // TWO families, each its own FSS curve (never mixed in one fit):
+    //   growing corner-rule cube — vertices [s,e]^3 with the SAME corners as the
+    //     Z-string (s=(L-1)/4, e=3(L-1)/4, R=e-s, aspect -> 1/2). Needs L >= 5:
+    //     at L=4 s=0 puts the cube on the open boundary and its coboundary is
+    //     truncated (odd edge count — no exact-half open membrane exists).
+    //   fixed-size anchor cube — centered R=1 (corner (L-2)/2), L >= 4: the
+    //     cheapest operator, existing at every size — the cross-method anchor.
+    // For each family: full = the ax-axis edges piercing the 6 cube faces
+    // (== product of the enclosed star operators); half = bottom (low-z) face +
+    // the lower halves of the 4 side faces, side layers 2(R+1) split floor/ceil
+    // in the order (x,low),(x,high),(y,low),(y,high)  ->  |half| = |full| / 2.
+    half_membrane_vector.clear();
+    full_membrane_vector.clear();
+    half_membrane_r1_vector.clear();
+    full_membrane_r1_vector.clear();
+    if (basis != 'x' || LATTICE_TYPE != "cubic" || LATTICE_DIMENSIONALITY != 3)
+        return;                    // unsupported: measurement throws if requested
+    const int L = SYSTEM_SIZE;
+    const int vertical = 2;
+
+    auto vertex_at = [&](const int p[3]) { return p[2] * L * L + p[1] * L + p[0]; };
+
+    auto build = [&](const int R, const int c0,
+                     std::vector<VertexPair>& half_out,
+                     std::vector<VertexPair>& full_out) {
+        const int corner[3] = {c0, c0, c0};
+        // The ax-axis edges piercing face (ax, side); vaxis/nlay restrict the
+        // in-face `vertical` coordinate to its bottom nlay vertex layers (-1 = full face).
+        auto add_face = [&](std::vector<VertexPair>& out, int ax, bool low, int vaxis, int nlay) {
+            int a = -1, b = -1;
+            for (int j = 0; j < 3; ++j)
+                if (j != ax)
+                    (a < 0 ? a : b) = j;
+            const int na = (vaxis == a) ? nlay : R + 1;
+            const int nb = (vaxis == b) ? nlay : R + 1;
+            for (int ia = 0; ia < na; ++ia) {
+                for (int ib = 0; ib < nb; ++ib) {
+                    int p[3];
+                    p[ax] = low ? corner[ax] - 1 : corner[ax] + R;
+                    p[a] = corner[a] + ia;
+                    p[b] = corner[b] + ib;
+                    int q[3] = {p[0], p[1], p[2]};
+                    q[ax] += 1;
+                    const int v1 = vertex_at(p), v2 = vertex_at(q);
+                    if (!exists_edge(v1, v2))
+                        throw std::runtime_error(
+                            "FM membrane: missing lattice edge (cube not in the bulk?)");
+                    out.emplace_back(v1, v2);
+                }
+            }
+        };
+
+        for (int ax = 0; ax < 3; ++ax)
+            for (const bool low : {true, false})
+                add_face(full_out, ax, low, -1, 0);
+        add_face(half_out, vertical, true, -1, 0);            // bottom cap
+        const int total = 2 * (R + 1), base = total / 4, rem = total % 4;
+        int k = 0;
+        for (int h = 0; h < 3; ++h) {
+            if (h == vertical)
+                continue;
+            for (const bool low : {true, false}) {
+                add_face(half_out, h, low, vertical, base + (k < rem ? 1 : 0));
+                ++k;
+            }
+        }
+        const std::size_t f = 6u * (R + 1) * (R + 1);
+        if (full_out.size() != f || half_out.size() != f / 2)
+            throw std::runtime_error("FM membrane: wrong edge counts after construction");
+    };
+
+    const int s = (L - 1) / 4;
+    const int e = 3 * (L - 1) / 4;
+    if (s >= 1)                    // growing family absent at L=4 (header comment)
+        build(e - s, s, half_membrane_vector, full_membrane_vector);
+    if (L >= 4)                    // R=1 anchor needs R=1 <= L-3
+        build(1, (L - 2) / 2, half_membrane_r1_vector, full_membrane_r1_vector);
+}
+
+std::complex<double> Lattice::membrane_half_full(
+    const std::vector<VertexPair>& half_pairs,
+    const std::vector<VertexPair>& full_pairs, const char* name) {
+    if (full_pairs.empty())
+        throw std::invalid_argument(
+            std::string(name) + " was not constructed: needs basis 'x' on a 3D "
+            "cubic lattice (corner-rule membrane: L >= 5; R=1 anchor: L >= 4). "
+            "Unconditional check: silent constant-1 results are worse.");
+    int half = 1, full = 1;
+    for (const auto& p : half_pairs)
+        half *= get_spin(edge_in_between(p.first, p.second));
+    for (const auto& p : full_pairs)
+        full *= get_spin(edge_in_between(p.first, p.second));
+    return std::complex<double>{static_cast<double>(half), static_cast<double>(full)};
+}
+
+std::complex<double> Lattice::fredenhagen_marcu_membrane() {
+    return membrane_half_full(half_membrane_vector, full_membrane_vector,
+                              "fredenhagen_marcu_membrane (corner-rule cube)");
+}
+
+std::complex<double> Lattice::fredenhagen_marcu_membrane_r1() {
+    return membrane_half_full(half_membrane_r1_vector, full_membrane_r1_vector,
+                              "fredenhagen_marcu_membrane_r1 (centered R=1 cube)");
+}
