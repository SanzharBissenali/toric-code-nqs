+void Lattice::construct_fredenhagen_marcu_membrane(char basis) {
+    // Magnetic ('t Hooft) FM membrane, 3D cubic lattice, basis 'x' only (sigma^x
+    // products are diagonal in the x eigenbasis). Mirrors the NQS operator
+    // (tc3d/fm.py magnetic_cube_edges) EDGE-FOR-EDGE: centered cube of (R+1)^3
+    // vertices, R = L/2, bulk constraint R <= L-3 (so L >= 5, matching the NQS
+    // side's exclusion of L=4 at aspect 1/2);
+    //   full = the ax-axis edges piercing each of the 6 cube faces
+    //          (== product of the enclosed star operators),
+    //   half = bottom (low-z) face + the lower halves of the 4 side faces,
+    //          side layers 2(R+1) split floor/ceil in the order
+    //          (x,low),(x,high),(y,low),(y,high)  ->  |half| = |full| / 2.
+    half_membrane_vector.clear();
+    full_membrane_vector.clear();
+    if (basis != 'x' || LATTICE_TYPE != "cubic" || LATTICE_DIMENSIONALITY != 3)
+        return;                    // unsupported: measurement throws if requested
+    const int L = SYSTEM_SIZE;
+    const int R = L / 2;
+    if (R < 1 || R > L - 3)
+        return;                    // no bulk cube at aspect 1/2 (L = 4)
+    const int c0 = (L - 1 - R) / 2;
+    const int corner[3] = {c0, c0, c0};
+    const int vertical = 2;
+
+    auto vertex_at = [&](const int p[3]) { return p[2] * L * L + p[1] * L + p[0]; };
+    // The ax-axis edges piercing face (ax, side); vaxis/nlay restrict the
+    // in-face `vertical` coordinate to its bottom nlay vertex layers (-1 = full face).
+    auto add_face = [&](std::vector<VertexPair>& out, int ax, bool low, int vaxis, int nlay) {
+        int a = -1, b = -1;
+        for (int j = 0; j < 3; ++j)
+            if (j != ax)
+                (a < 0 ? a : b) = j;
+        const int na = (vaxis == a) ? nlay : R + 1;
+        const int nb = (vaxis == b) ? nlay : R + 1;
+        for (int ia = 0; ia < na; ++ia) {
+            for (int ib = 0; ib < nb; ++ib) {
+                int p[3];
+                p[ax] = low ? corner[ax] - 1 : corner[ax] + R;
+                p[a] = corner[a] + ia;
+                p[b] = corner[b] + ib;
+                int q[3] = {p[0], p[1], p[2]};
+                q[ax] += 1;
+                const int v1 = vertex_at(p), v2 = vertex_at(q);
+                if (!exists_edge(v1, v2))
+                    throw std::runtime_error(
+                        "FM membrane: missing lattice edge (cube not in the bulk?)");
+                out.emplace_back(v1, v2);
+            }
+        }
+    };
+
+    for (int ax = 0; ax < 3; ++ax)
+        for (const bool low : {true, false})
+            add_face(full_membrane_vector, ax, low, -1, 0);
+    add_face(half_membrane_vector, vertical, true, -1, 0);            // bottom cap
+    const int total = 2 * (R + 1), base = total / 4, rem = total % 4;
+    int k = 0;
+    for (int h = 0; h < 3; ++h) {
+        if (h == vertical)
+            continue;
+        for (const bool low : {true, false}) {
+            add_face(half_membrane_vector, h, low, vertical, base + (k < rem ? 1 : 0));
+            ++k;
+        }
+    }
+    const std::size_t f = 6u * (R + 1) * (R + 1);
+    if (full_membrane_vector.size() != f || half_membrane_vector.size() != f / 2)
+        throw std::runtime_error("FM membrane: wrong edge counts after construction");
+}
+
+std::complex<double> Lattice::fredenhagen_marcu_membrane() {
+    if (full_membrane_vector.empty())
+        throw std::invalid_argument(
+            "fredenhagen_marcu_membrane requires basis 'x' on a 3D cubic lattice "
+            "with L >= 5 (unconditional check: silent constant-1 results are worse)");
+    int half = 1, full = 1;
+    for (const auto& p : half_membrane_vector)
+        half *= get_spin(edge_in_between(p.first, p.second));
+    for (const auto& p : full_membrane_vector)
+        full *= get_spin(edge_in_between(p.first, p.second));
+    return std::complex<double>{static_cast<double>(half), static_cast<double>(full)};
+}
